{
  "name": "dsh-plugin-example",
  "version": "0.1.5",
  "description": "A 70-line DeepSeek Harness plugin: one sidebar tab, one button, one test.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "example": "node examples/render.mjs",
    "test": "node --test",
    "check": "dsh-plugin verify .",
    "check:lockfile": "node scripts/check-lockfile.mjs"
  },
  "devDependencies": {
    "dsh-plugin-toolkit": "^0.20.9",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "example"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/WJDdidi-1/dsh-plugin-example.git"
  },
  "homepage": "https://github.com/WJDdidi-1/dsh-plugin-example#readme",
  "bugs": {
    "url": "https://github.com/WJDdidi-1/dsh-plugin-example/issues"
  }
}
